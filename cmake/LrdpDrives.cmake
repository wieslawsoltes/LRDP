  add_executable(lrdp_drive_protocol_tests tests/drive_protocol_tests.cpp)
  target_link_libraries(lrdp_drive_protocol_tests PRIVATE lrdp_protocol)
  add_test(NAME drive_protocol COMMAND lrdp_drive_protocol_tests)
endif()
if(BUILD_TESTING)
  add_executable(lrdp_drive_bridge_tests tests/drive_bridge_tests.cpp)
  target_link_libraries(lrdp_drive_bridge_tests PRIVATE lrdp_protocol)
  add_test(NAME drive_bridge COMMAND lrdp_drive_bridge_tests)
